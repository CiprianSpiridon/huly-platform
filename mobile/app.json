{
  "expo": {
    "name": "Huly",
    "slug": "huly",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "huly",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#161719"
    },
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.huly.mobile",
      "associatedDomains": [
        "applinks:huly.io",
        "applinks:app.huly.io"
      ],
      "infoPlist": {
        "NSCameraUsageDescription": "Huly needs camera access to take photos for attachments.",
        "NSPhotoLibraryUsageDescription": "Huly needs photo library access to attach images to issues and messages."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#161719",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "com.huly.mobile",
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "huly.io" },
            { "scheme": "https", "host": "app.huly.io" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#161719",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#205DC2"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Huly needs photo library access to attach images to issues and messages.",
          "cameraPermission": "Huly needs camera access to take photos for attachments."
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "organization": "huly",
          "project": "huly-mobile"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "your-eas-project-id"
      },
      "router": {
        "origin": "https://app.huly.io"
      }
    }
  }
}
